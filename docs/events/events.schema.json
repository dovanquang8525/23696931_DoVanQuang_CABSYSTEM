{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cab.example/contracts/events.schema.json",
  "title": "CAB MVP RabbitMQ domain events",
  "oneOf": [
    {
      "$ref": "#/$defs/account_registered"
    },
    {
      "$ref": "#/$defs/driver_approval_changed"
    },
    {
      "$ref": "#/$defs/booking_created"
    },
    {
      "$ref": "#/$defs/booking_invitation_created"
    },
    {
      "$ref": "#/$defs/booking_assigned"
    },
    {
      "$ref": "#/$defs/booking_canceled"
    },
    {
      "$ref": "#/$defs/booking_no_driver"
    },
    {
      "$ref": "#/$defs/trip_arrived"
    },
    {
      "$ref": "#/$defs/trip_completed"
    },
    {
      "$ref": "#/$defs/trip_canceled"
    },
    {
      "$ref": "#/$defs/payment_completed"
    },
    {
      "$ref": "#/$defs/payment_failed"
    }
  ],
  "$defs": {
    "account_registered": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "eventType": {
          "const": "account.registered"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "const": "auth_service"
        },
        "aggregateId": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{24}|[bditpvnr][a-z0-9]{1,15})$"
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accountId": {
              "type": "string",
              "pattern": "^[0-9a-f]{24}$"
            },
            "role": {
              "enum": [
                "CUSTOMER",
                "DRIVER"
              ]
            },
            "fullName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[^<>]*$"
            },
            "email": {
              "type": "string",
              "format": "email",
              "maxLength": 254
            },
            "cid": {
              "type": "string",
              "minLength": 2,
              "maxLength": 16,
              "pattern": "^c[a-z0-9]{1,15}$"
            },
            "did": {
              "type": "string",
              "minLength": 2,
              "maxLength": 16,
              "pattern": "^d[a-z0-9]{1,15}$"
            },
            "plateNumber": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "pattern": "^[^<>]*$"
            }
          },
          "required": [
            "accountId",
            "role",
            "fullName",
            "email"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "role": {
                    "const": "CUSTOMER"
                  }
                }
              },
              "then": {
                "required": [
                  "cid"
                ],
                "not": {
                  "required": [
                    "did"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "role": {
                    "const": "DRIVER"
                  }
                }
              },
              "then": {
                "required": [
                  "did"
                ],
                "not": {
                  "required": [
                    "cid"
                  ]
                }
              }
            }
          ]
        }
      },
      "required": [
        "eventId",
        "eventType",
        "occurredAt",
        "producer",
        "aggregateId",
        "aggregateVersion",
        "correlationId",
        "payload"
      ]
    },
    "driver_approval_changed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "type": "string",
