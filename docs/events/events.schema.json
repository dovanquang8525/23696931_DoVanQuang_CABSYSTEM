        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "driverId": {
              "type": "string",
              "pattern": "^d[a-z0-9]{1,15}$"
            },
            "recipientAccountId": {
              "type": "string",
              "pattern": "^[0-9a-f]{24}$"
            },
            "approvalStatus": {
              "enum": [
                "APPROVED",
                "REJECTED"
              ]
            },
            "reviewedAt": {
              "type": "string",
              "format": "date-time"
            },
            "rejectionReason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "^[^<>]*$"
            }
          },
          "required": [
            "driverId",
            "recipientAccountId",
            "approvalStatus",
            "reviewedAt"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "approvalStatus": {
                    "const": "REJECTED"
                  }
                }
              },
              "then": {
                "required": [
                  "rejectionReason"
                ]
              }
            }
          ]
        }
      },
      "required": [
        "eventId",
        "eventType",
        "occurredAt",
        "producer",
        "aggregateId",
        "aggregateVersion",
        "correlationId",
        "payload"
      ]
    },
