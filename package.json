{
  "name": "cab-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "gateway",
    "services/*"
  ],
  "scripts": {
    "setup:local": "node scripts/setup-local-env.cjs",
    "check": "node scripts/check-lock.cjs && node scripts/check-foundation.cjs && node scripts/check-identity-contracts.cjs && node --test scripts/identity.test.cjs scripts/business.test.cjs",
    "infra:init": "node scripts/bootstrap-infra.cjs",
    "test": "node --test scripts/identity.test.cjs scripts/business.test.cjs scripts/postman-format.test.cjs scripts/event-bus.test.cjs scripts/seed-admin.test.cjs",
    "test:runtime": "node --env-file=.env scripts/smoke-backend.cjs",
    "test:onboarding": "node --env-file=.env scripts/smoke-onboarding.cjs",
    "postman:local": "node --env-file=.env scripts/export-local-postman.cjs",
    "test:validation": "node --env-file=.env scripts/smoke-validation.cjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.6",
    "@grpc/proto-loader": "^0.7.13",
    "amqplib": "^0.10.5",
    "argon2": "^0.41.1",
    "jsonwebtoken": "^9.0.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "mongodb": "^6.12.0",
    "redis": "^4.7.0",
    "yaml": "^2.7.0"
  }
}
