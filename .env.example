# CAB System: local backend configuration; runtime verification is still required.
# Secret values are intentionally empty. Never run with empty/template secrets.
# The root .env is local only; future startup code must explicitly load/validate it.
# Host/port defaults below are for processes on this machine, not Docker DNS.
# Compose must map each service's own DB credentials and required shared settings;
# do not inject every service's database credentials into every container.

# Node.js / REST Gateway; only the Gateway is the public client entry point.
NODE_ENV=development
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3000

# MongoDB: separate logical databases and credentials per owning service.
# No databases/users are provisioned by this file. Verify auth source in Compose.
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_AUTH_SOURCE=admin
AUTH_MONGODB_DATABASE=auth_db
AUTH_MONGODB_USERNAME=cab_auth
AUTH_MONGODB_PASSWORD=
CUSTOMER_MONGODB_DATABASE=customer_db
CUSTOMER_MONGODB_USERNAME=cab_customer
CUSTOMER_MONGODB_PASSWORD=
DRIVER_MONGODB_DATABASE=driver_db
DRIVER_MONGODB_USERNAME=cab_driver
DRIVER_MONGODB_PASSWORD=
BOOKING_MONGODB_DATABASE=booking_db
BOOKING_MONGODB_USERNAME=cab_booking
BOOKING_MONGODB_PASSWORD=
TRIP_MONGODB_DATABASE=trip_db
TRIP_MONGODB_USERNAME=cab_trip
TRIP_MONGODB_PASSWORD=
PAYMENT_MONGODB_DATABASE=payment_db
PAYMENT_MONGODB_USERNAME=cab_payment
PAYMENT_MONGODB_PASSWORD=
NOTIFICATION_MONGODB_DATABASE=notification_db
NOTIFICATION_MONGODB_USERNAME=cab_notification
NOTIFICATION_MONGODB_PASSWORD=
RATING_MONGODB_DATABASE=rating_db
RATING_MONGODB_USERNAME=cab_rating
RATING_MONGODB_PASSWORD=

# Redis: Gateway rate-limit counters only. Configure the same password on Redis.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# RabbitMQ: asynchronous events; cab.events follows SRS NFR27.
# Provision this user/vhost separately; no broker setup is performed here.
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_VHOST=cab
RABBITMQ_USERNAME=cab_local
RABBITMQ_PASSWORD=
RABBITMQ_EXCHANGE=cab.events

# JWT: SRS RULE47. Auth issues tokens; Gateway/services verify them.
# Keep JWT and gRPC internal credentials independent.
JWT_ALGORITHM=HS256
JWT_ISSUER=cab-auth
JWT_AUDIENCE=cab-api
JWT_EXPIRES_IN_SECONDS=3600
JWT_SECRET=

# Gateway rate limits from SRS RULE45; values apply per 60-second window.
# Redis failure must not silently bypass limits (SRS NFR25).
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX_PER_IP=10
RATE_LIMIT_OTP_REQUEST_MAX_PER_IP=5
RATE_LIMIT_OTP_VERIFY_MAX_PER_IP=10
RATE_LIMIT_BOOKING_MAX_PER_ACCOUNT=10
RATE_LIMIT_BOOKING_MAX_PER_IP=120
# Auth enforces these OTP limits in addition to the Gateway counters.
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_VERIFY_MAX_ATTEMPTS_PER_CHALLENGE=5

# gRPC: local-only addresses; never publish service ports in Docker Compose.
# Future servers bind their own endpoint; callers use the destination endpoint.
# Replace loopback with internal service DNS when running inside containers.
# Shared internal credential is required by SRS NFR26; not a client JWT.
GRPC_INTERNAL_SECRET=
AUTH_GRPC_HOST=127.0.0.1
AUTH_GRPC_PORT=50051
CUSTOMER_GRPC_HOST=127.0.0.1
CUSTOMER_GRPC_PORT=50052
DRIVER_GRPC_HOST=127.0.0.1
DRIVER_GRPC_PORT=50053
BOOKING_GRPC_HOST=127.0.0.1
BOOKING_GRPC_PORT=50054
TRIP_GRPC_HOST=127.0.0.1
TRIP_GRPC_PORT=50055
PAYMENT_GRPC_HOST=127.0.0.1
PAYMENT_GRPC_PORT=50056
NOTIFICATION_GRPC_HOST=127.0.0.1
NOTIFICATION_GRPC_PORT=50057
RATING_GRPC_HOST=127.0.0.1
RATING_GRPC_PORT=50058

# Backend bootstrap: secrets remain local; never replace existing keys.
# setup:local fills only missing/empty settings and prints no secret values.
MONGODB_ROOT_USERNAME=cab_root
MONGODB_ROOT_PASSWORD=
MONGODB_REPLICA_SET=rs0
MONGODB_REPLICA_KEY=
OTP_MOCK_MODE=true
OTP_HMAC_SECRET=
MOCK_CALLBACK_SECRET=
DRIVER_DATA_KEY_BASE64=

# Demo seed password; setup:local creates it locally, never replaces an existing value.
SEED_PASSWORD=

# Optional host-side runtime tests: existing ADMIN password when different from seed.
# No service/container needs this test-client credential.
CAB_ADMIN_PASSWORD=

# Demo location rows A/B are provisioned in each owning service DB on startup.
# Their coordinates are stored in demo_locations; existing rows are never overwritten.
